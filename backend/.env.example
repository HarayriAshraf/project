# Copy this file to .env and fill in your values

# SQL Server instance name (e.g. localhost, .\SQLEXPRESS, SERVER\INSTANCE)
DB_SERVER=localhost

# Database name (will be created by database_setup.sql)
DB_DATABASE=SupplyChainPro

# SQL Server login credentials
# If using Windows Authentication, set DB_USER and DB_PASSWORD to empty
# and add Trusted_Connection=yes to the connection string in main.py
DB_USER=sa
DB_PASSWORD=Your_password123

# ODBC Driver - must match what is installed on your machine
# Run: Get-OdbcDriver | Select-Object Name  (in PowerShell) to list installed drivers
DB_DRIVER={ODBC Driver 17 for SQL Server}

# Encryption settings
DB_ENCRYPT=no
DB_TRUST_CERT=yes

# CORS - set to your frontend URL in production
FRONTEND_URL=*
